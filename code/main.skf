// skyforge-case

функция в_кэмел(текст) {
    пусть рез = ""
    пусть след_заглавная = ложь
    для с в строка_символы(текст) {
        если с == "_" или с == "-" или с == " " {
            след_заглавная = истина
        } иначе {
            если след_заглавная { рез = рез + верхний_регистр(с) } иначе { рез = рез + с }
            след_заглавная = ложь
        }
    }
    вернуть рез
}

функция в_снейк(текст) {
    пусть рез = ""
    для с в строка_символы(текст) {
        если с == "-" или с == " " { рез = рез + "_" } иначе { рез = рез + нижний_регистр(с) }
    }
    вернуть рез
}
